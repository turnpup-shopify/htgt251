{% comment %}
  PDP Elevated Card — 1B Terracotta spec
  Combines quantity stepper + ATC button + trust badge grid in a styled card.
  Intended to replace the standalone Quantity Selector and Buy Buttons blocks.

  Accepts:
  - product {Object}
  - product_form_id {String} — shared form ID used by variant pickers
  - section_id {String}
  - block {Object}
{% endcomment %}

{%- assign accent   = settings.pdp_card_accent_color | default: '#b5572a' -%}
{%- assign cta_font = settings.pdp_card_cta_font | default: 'Fraunces, Georgia, serif' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=Fraunces:wght@300;400;500&display=swap">

<style>
  .pdp-elevated-card {
    --card-accent: {{ accent }};
    --card-cta-font: {{ cta_font }};
    background: #fff;
    border-radius: 24px;
    border: 1px solid oklch(0.92 0.008 60);
    box-shadow:
      0 1px 3px oklch(0.2 0 0 / 0.05),
      0 20px 40px oklch(0.2 0 0 / 0.08);
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* ── Actions row ─────────────────────────────────────────── */
  .pdp-elevated-card__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pdp-elevated-card__stepper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid oklch(0.9 0.008 60);
    border-radius: 100px;
    padding: 2px 6px;
    flex-shrink: 0;
  }

  .pdp-elevated-card__stepper-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: oklch(0.3 0.01 60);
    padding: 0;
    border-radius: 100px;
    transition: opacity 0.15s;
  }

  .pdp-elevated-card__stepper-btn:hover { opacity: 0.55; }
  .pdp-elevated-card__stepper-btn svg { display: block; }

  .pdp-elevated-card__stepper-count {
    width: 26px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 15px;
    font-weight: 600;
    color: oklch(0.25 0.01 60);
    padding: 0;
    line-height: 1;
    -moz-appearance: textfield;
    appearance: textfield;
    font-family: inherit;
  }

  .pdp-elevated-card__stepper-count::-webkit-inner-spin-button,
  .pdp-elevated-card__stepper-count::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pdp-elevated-card__form-wrapper {
    flex: 1;
  }

  .pdp-elevated-card__form-wrapper .form {
    margin: 0;
  }

  .pdp-elevated-card__atc {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 38px;
    background: var(--card-accent);
    border: none;
    border-radius: 100px;
    color: #fff;
    font-family: var(--card-cta-font);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    cursor: pointer;
    padding: 0 20px;
    transition: opacity 0.15s;
  }

  .pdp-elevated-card__atc:hover:not([disabled]) { opacity: 0.88; }

  .pdp-elevated-card__atc[disabled] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* ── Divider ─────────────────────────────────────────────── */
  .pdp-elevated-card__divider {
    height: 1px;
    background: oklch(0.92 0.008 60);
  }

  /* ── Badge grid ──────────────────────────────────────────── */
  .pdp-elevated-card__badges {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 14px;
  }

  .pdp-elevated-card__badge {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .pdp-elevated-card__badge-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--card-accent);
    margin-top: 1px;
  }

  .pdp-elevated-card__badge span {
    font-size: 12px;
    font-weight: 500;
    color: oklch(0.3 0.01 60);
    line-height: 1.4;
    font-family: Archivo, sans-serif;
  }
</style>

<div class="pdp-elevated-card" id="PdpElevatedCard-{{ section_id }}" {{ block.shopify_attributes }}>

  <div class="pdp-elevated-card__actions">

    <quantity-input class="pdp-elevated-card__stepper">
      <button
        type="button"
        name="minus"
        class="pdp-elevated-card__stepper-btn"
        aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <line x1="3" y1="8" x2="13" y2="8"/>
        </svg>
      </button>
      <input
        type="number"
        name="quantity"
        min="1"
        value="1"
        class="pdp-elevated-card__stepper-count"
        aria-label="{{ 'products.product.quantity.label' | t }}"
        form="{{ product_form_id }}"
      >
      <button
        type="button"
        name="plus"
        class="pdp-elevated-card__stepper-btn"
        aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
          <line x1="8" y1="3" x2="8" y2="13"/>
          <line x1="3" y1="8" x2="13" y2="8"/>
        </svg>
      </button>
    </quantity-input>

    <product-form class="pdp-elevated-card__form-wrapper">
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <svg aria-hidden="true" focusable="false" class="icon icon-error" viewBox="0 0 13 13">
          <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
          <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
        </svg>
        <span class="product-form__error-message"></span>
      </div>
      {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
        <button
          type="submit"
          name="add"
          class="pdp-elevated-card__atc"
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
        >
          <span>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
          <div class="loading-overlay__spinner hidden">
            <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
            </svg>
          </div>
        </button>
      {%- endform -%}
    </product-form>

  </div>

  <div class="pdp-elevated-card__divider" role="separator"></div>

  <div class="pdp-elevated-card__badges">

    <div class="pdp-elevated-card__badge">
      <svg class="pdp-elevated-card__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
        <line x1="12" y1="22.08" x2="12" y2="12"/>
      </svg>
      <span>
        {{- block.settings.badge_1_line1 | default: 'Free shipping' -}}<br>
        {{- block.settings.badge_1_line2 | default: 'on orders $99+' -}}
      </span>
    </div>

    <div class="pdp-elevated-card__badge">
      <svg class="pdp-elevated-card__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      <span>
        {{- block.settings.badge_2_line1 | default: 'Easy returns' -}}<br>
        {{- block.settings.badge_2_line2 | default: '30-day guarantee' -}}
      </span>
    </div>

    <div class="pdp-elevated-card__badge">
      <svg class="pdp-elevated-card__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/>
        <line x1="16" y1="8" x2="2" y2="22"/>
        <line x1="17" y1="15" x2="9" y2="15"/>
      </svg>
      <span>
        {{- block.settings.badge_3_line1 | default: 'Eco packaging' -}}<br>
        {{- block.settings.badge_3_line2 | default: 'sustainably made' -}}
      </span>
    </div>

    <div class="pdp-elevated-card__badge">
      <svg class="pdp-elevated-card__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span>
        {{- block.settings.badge_4_line1 | default: 'Expert support' -}}<br>
        {{- block.settings.badge_4_line2 | default: '7 days a week' -}}
      </span>
    </div>

  </div>

</div>
