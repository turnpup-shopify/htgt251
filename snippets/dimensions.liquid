{% comment %}
  Renders product dimensions parsed from text like "16 W X 24 H X 16 D (in)".

  Accepts:
  - dimensions: {String} Raw dimensions text
  - layout: {String} 'table' (default) or 'row', a definition list of
    label and value pairs (optional)
{% endcomment %}
{%- assign raw_dimensions = dimensions | default: '' -%}
{%- if layout == 'row' -%}
  {%- comment -%} Some products write 48"W X 17"H. Turn the inch marks into spaces so each part splits into value and unit. {%- endcomment -%}
  {%- assign raw_dimensions = raw_dimensions | replace: '&quot;', ' ' | replace: '&#34;', ' ' | replace: '"', ' ' | replace: '”', ' ' -%}
{%- endif -%}
{%- if raw_dimensions != '' -%}

  {%- assign has_multiple_sizes = false -%}
  {%- if raw_dimensions contains 'Small:' or raw_dimensions contains 'Medium:' or raw_dimensions contains 'Large:' or raw_dimensions contains 'Chair:' or raw_dimensions contains 'Arm:' or raw_dimensions contains 'Seat:' or raw_dimensions contains 'Shade:' or raw_dimensions contains 'Lamp:' or raw_dimensions contains 'Summary:' or raw_dimensions contains 'Overall:' -%}
    {%- assign has_multiple_sizes = true -%}
    {%- assign multiple_dimensions = raw_dimensions | replace: 'Small:', '##SIZE##Small:' | replace: 'Medium:', '##SIZE##Medium:' | replace: 'Large:', '##SIZE##Large:' | replace: 'Arm:', '##SIZE##Arm:' | replace: 'Seat:', '##SIZE##Seat:' | replace: 'Chair:', '##SIZE##Chair:' | replace: 'Shade:', '##SIZE##Shade:' | replace: 'Lamp:', '##SIZE##Lamp:' | replace: 'Summary:', '##SIZE##Summary:' | replace: 'Overall:', '##SIZE##Overall:' -%}
    {%- assign size_sets = multiple_dimensions | split: '##SIZE##' -%}
  {%- endif -%}

  {%- if has_multiple_sizes -%}
    {%- comment -%} Row layout puts every set in one line, prefixing each label with its set name, e.g. Shade Height. {%- endcomment -%}
    {%- if layout == 'row' -%}<dl class="dimensions-row">{%- endif -%}
    {%- for size_set in size_sets -%}
      {%- assign check = size_set | strip_html %}
      {%- if check != "" and check != null -%}
        {%- assign current_set = size_set | strip -%}
        {%- assign size_parts = current_set | split: ':' -%}
        {%- assign size_label = size_parts[0] | strip -%}
        {%- assign dimension_part = size_parts[1] | default: '' | strip -%}
        {%- if size_parts.size == 1 -%}
          {%- assign dimension_part = size_label -%}
          {%- assign size_label = '' -%}
        {%- endif -%}
        {%- assign label_prefix = size_label | strip_html | strip -%}
        {%- if label_prefix == 'Overall' or label_prefix == 'Summary' -%}
          {%- assign label_prefix = '' -%}
        {%- endif -%}
        {%- assign clean_dimensions = dimension_part | replace: '(', '' | replace: ')', '' | replace: 'IN', '' | replace: 'in', '' | strip_html | strip_newlines | strip | upcase -%}
        {%- assign dims = clean_dimensions | split: ' X ' -%}

        {%- unless layout == 'row' -%}
          <h4>{{ size_label }}</h4>
          <table style="border:  1px solid black !important; border-collapse: collapse; width: 200px; margin-bottom: 20px;">
            <tbody>
        {%- endunless -%}
            {%- for dim in dims -%}
              {%- assign parts = dim | split: ' ' -%}
              {%- assign value = parts[0] | strip -%}
              {%- assign unit = parts[1] | strip -%}

              {%- if unit == 'W' -%}
                {%- assign label = 'Width' -%}
              {%- elsif unit == 'H' -%}
                {%- assign label = 'Height' -%}
              {%- elsif unit == 'D' -%}
                {%- assign label = 'Depth' -%}
              {%- elsif unit == 'SH' -%}
                {%- assign label = 'Seat Height' -%}
              {%- else -%}
                {%- assign label = unit -%}
              {%- endif -%}

              {%- if layout == 'row' -%}
                <div class="dimensions-row__item">
                  <dt>{% if label_prefix != '' %}{{ label_prefix }} {% endif %}{{ label | default: 'Size' }}</dt>
                  <dd>{{ value }} in</dd>
                </div>
              {%- else -%}
                <tr>
                  <td style="width: 100px; background-color: #eee; border: 1px solid black; padding: 8px;">{{ label }}</td>
                  <td style="width: 100px; border: 1px solid black; padding: 8px;">{{ value }} inches</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
        {%- unless layout == 'row' -%}
            </tbody>
          </table>
        {%- endunless -%}

      {%- endif -%}
    {%- endfor -%}
    {%- if layout == 'row' -%}</dl>{%- endif -%}

  {%- else -%}
    {%- assign clean_dimensions = raw_dimensions | replace: '(', '' | replace: ')', '' | replace: 'IN', '' | replace: 'in', '' | strip_html | strip_newlines | strip | upcase -%}
    {%- assign dims = clean_dimensions | split: ' X ' -%}

    {%- if layout == 'row' -%}
      <dl class="dimensions-row">
    {%- else -%}
      <table style="border: 1px solid black !important; border-collapse: collapse; width: 250px;">
        <tbody>
    {%- endif -%}
        {%- for dim in dims -%}
          {%- assign parts = dim | split: ' ' -%}
          {%- assign value = parts[0] | strip -%}
          {%- assign unit = parts[1] | strip -%}

          {%- if unit == 'W' -%}
            {%- assign label = 'Width' -%}
          {%- elsif unit == 'H' -%}
            {%- assign label = 'Height' -%}
          {%- elsif unit == 'D' -%}
            {%- assign label = 'Depth' -%}
          {%- elsif unit == 'SH' -%}
            {%- assign label = 'Seat Height' -%}
          {%- elsif unit == 'SHADEH' -%}
            {%- assign label = 'Shade Height' -%}
          {%- elsif unit == 'SHADED' -%}
            {%- assign label = 'Shade Diameter' -%}
          {%- elsif unit == 'LAMPH' -%}
            {%- assign label = 'Lamp Height' -%}
          {%- elsif unit == 'LAMPW' -%}
            {%- assign label = 'Lamp Width' -%}
          {%- elsif unit == 'LAMPD' -%}
            {%- assign label = 'Lamp Depth' -%}
          {%- elsif unit == 'DIA.' -%}
            {%- assign label = 'Diameter' -%}
          {%- elsif unit == 'DIA' -%}
            {%- assign label = 'Diameter' -%}
          {%- else -%}
            {%- assign label = unit -%}
          {%- endif -%}

          {%- if layout == 'row' -%}
            <div class="dimensions-row__item">
              <dt>{{ label | default: 'Size' }}</dt>
              <dd>{{ value }} in</dd>
            </div>
          {%- else -%}
            <tr>
              <td style="width: 100px; background-color: #eee; border: 1px solid black; padding: 8px;">{{ label }}</td>
              <td style="width: 100px; border: 1px solid black; padding: 8px;">{{ value }} inches</td>
            </tr>
          {%- endif -%}
        {%- endfor -%}
    {%- if layout == 'row' -%}
      </dl>
    {%- else -%}
        </tbody>
      </table>
    {%- endif -%}
  {%- endif -%}

{%- endif -%}