{% assign has_metaobject = false %}
{% if section.settings.tp_metaobject != blank %}
  {% assign has_metaobject = true %}
{% endif %}

{% if has_metaobject or section.blocks.size > 0 %}
    {% assign current_url = '' %}
    {% assign current_title = '' %}
      {% if template contains 'page' %}
        {% assign current_url = page.url %}
        {% assign current_title = page.title %}
      {% elsif template contains 'blog' %}
        {% assign current_url = blog.url %}
        {% assign current_title = blog.title %}
      {% elsif template contains 'article' %}
        {% assign current_url = blog.url %}
        {% assign current_title = blog.title %}
      {% elsif template contains 'collection' %}
        {% assign current_url = collection.url %}
        {% assign current_title = collection.title %}
      {% elsif template contains 'product' %}
        {% assign current_url = product.url %}
        {% assign current_title = product.title %}
      {% endif %}

    <div class="tp-question-container">
        <div>
            <div class="section-header">
                <div class="section-header-title">
                    <h2 class="turnpup_header">{{ section.settings.section_heading | default: 'Common questions' }}</h2>
                </div>
            </div>
        </div>

        {% if has_metaobject %}
            {% render 'tp-question' for section.settings.tp_metaobject as t %}
        {% else %}
            {% for block in section.blocks %}
                {% if block.settings.question != blank and block.settings.answer != blank %}
                    <div class="page-accordion--single" {{ block.shopify_attributes }}>
                        <button class="turnpup_question" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" js-accordion-header="">
                            <h3 class="page-accordion__title">
                                {{ block.settings.question }}
                            </h3>
                            <span class="tp-faq-icon" aria-hidden="true"></span>
                        </button>
                        <div class="turnpup_answer" js-accordion-content="" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"{% unless forloop.first %} style="display: none;"{% endunless %}>
                            <span style="display:block;margin-top:8px;">
                                {{ block.settings.answer }}
                            </span>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% endif %}
    </div>

    {% if has_metaobject %}
        <script type="application/ld+json"
        id="thd-helmet__script--seoGeneratedContentFAQ">
        {
            "@context": "http://schema.org",
            "@type": "FAQPage",
            "name": "{{ current_title }}",
            "url": "https://htgtfurniture.com{{ current_url }}",
            "mainEntity": [{% render 'tp-question-schema' for section.settings.tp_metaobject as t %}]
        }
        </script>
    {% endif %}

    <style>
        .tp-question {
            background: {{ section.settings.background_color }}
        }
        .tp-question-container {
            margin-top: {{ section.settings.padding_top }}px;
            margin-bottom: {{ section.settings.padding_bottom }}px;
            margin-left: {{ section.settings.padding_left }}px;
            margin-right: {{ section.settings.padding_right }}px;
            max-width: 760px;
            border-top: 1px solid #DCD7CE;
            padding-top: 56px;
            box-sizing: border-box;
        }
        .turnpup_header {
            font-family: 'Archivo', sans-serif;
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 24px;
            color: #2B2723;
        }
        .page-accordion--single {
            border-bottom: 1px solid #DCD7CE;
        }
        .turnpup_question {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            background: none;
            border: none;
            padding: 18px 0;
            cursor: pointer;
            text-align: left;
        }
        .page-accordion__title {
            margin: 0;
            flex: 1;
            min-width: 0;
            padding-right: 12px;
        }
        .page-accordion__title p {
            font-family: 'Archivo', sans-serif;
            font-size: 15.5px;
            font-weight: 600;
            color: #2B2723;
            margin: 0;
        }
        .tp-faq-icon {
            font-size: 20px;
            font-weight: 400;
            color: #736C64;
            flex-shrink: 0;
            line-height: 1;
            padding-top: 2px;
        }
        .tp-question .turnpup_question::before,
        .tp-question .turnpup_question::after {
            content: none;
        }
        .tp-faq-icon::before { content: '+'; }
        .turnpup_question[aria-expanded="true"] .tp-faq-icon::before { content: '\2212'; }
        .turnpup_answer {
            font-size: 14.5px;
            line-height: 1.6;
            color: #736C64;
            max-width: 640px;
            padding-bottom: 20px;
        }
        .turnpup_answer p {
            margin: 0;
        }
        @media screen and (max-width: 700px) {
            .tp-question-container {
                margin-top: {{ section.settings.mobile_padding_top }}px;
                margin-bottom: {{ section.settings.mobile_padding_bottom }}px;
                margin-left: {{ section.settings.mobile_padding_left }}px;
                margin-right: {{ section.settings.mobile_padding_right }}px;
            }
        }
    </style>

{% endif %}
    
    {% schema %}
{
  "name": "TP - New - Question",
  "class": "tp-question",
  "settings": [
    {
      "type": "checkbox",
      "id": "section_padding",
      "label": "Show spacing around section",
      "default": true
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Common questions"
    },
    {
      "type": "metaobject_list",
      "id": "tp_metaobject",
      "label": "Image Row Metaobject",
      "info": "Add a metaobject",
      "metaobject_type": "question_and_answer"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section Padding Buttom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section Padding Right",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "section Padding Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Section Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Section Padding Buttom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Section Padding Right",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile section Padding Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "background_opacityy",
      "min": 0,
      "max": 100,
      "step": 10,
      "label": "Background Opacity",
      "unit": "%",
      "default": 0
    },
    {
      "type": "text",
      "id": "overall_width",
      "label": "Overall Width",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "overall_width_text",
      "label": "Overall Width for Text",
      "default": "80%"
    },
    {
      "type": "color",
      "id": "turnpup_bottom_border_color",
      "label": "Bottom Border Color",
      "default": "#F4B237"
    },
    {
      "type": "text",
      "id": "turnpup_container_margin_top_bottom",
      "label": "Container Margin Top Bottom",
      "default": "60px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "background_opacity",
      "label": "Background Opacity",
      "default": "0.2"
    },
    {
      "type": "color",
      "id": "mobile_background_color",
      "label": "Mobile Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "name": "Question",
      "type": "Question",
      "settings": [
        {
          "type": "richtext",
          "id": "question",
          "label": "Question",
          "default": "<p>How do I likka the leffs?</p>"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>PeePaws Lickaloo Spindrifter the 4th</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TP - New - Question",
      "category": "FAQ & Tools"
    }
  ]
}
{% endschema %}