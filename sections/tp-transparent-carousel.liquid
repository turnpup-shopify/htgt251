{%- liquid
  if section.settings.collection != blank
    assign source_collection = section.settings.collection
  else
    assign source_collection = collections['all']
  endif

  assign max_items = section.settings.max_items
  assign parallax_intensity = section.settings.parallax_intensity | times: 0.01
  assign items_per_row = section.settings.items_per_row
  assign item_width_pct = 100.0 | divided_by: items_per_row
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="tp-float-carousel section-{{ section.id }}-padding"
  data-parallax-section="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }};"
>
  {%- if section.settings.title != blank -%}
    <h2 class="tp-float-carousel__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <!-- DEBUG: remove after testing -->
  <div style="background:#ffc;padding:12px;margin:0 40px 12px;font-size:13px;font-family:monospace;border:2px solid #cc0;">
    Collection: {{ source_collection.title | default: 'NONE' }} |
    Product count: {{ source_collection.products_count | default: 0 }} |
    {%- for product in source_collection.products limit: 3 -%}
      <br>Product: {{ product.title }} | Meta: {{ product.metafields.custom.transparent_image | default: 'EMPTY' }} | Value: {{ product.metafields.custom.transparent_image.value | default: 'EMPTY' }}
    {%- endfor -%}
  </div>
  <!-- END DEBUG -->

  <div class="tp-float-carousel__wrapper">
    <div class="tp-float-carousel__track" id="tp-track-{{ section.id }}">
      {%- assign item_index = 0 -%}
      {%- assign speeds = '0.03,0.06,0.04,0.05,0.02' | split: ',' -%}

      {%- for product in source_collection.products limit: max_items -%}
        {%- assign tp_meta = product.metafields.custom.transparent_image -%}
        {%- if tp_meta != blank -%}
          {%- assign speed_index = item_index | modulo: speeds.size -%}
          {%- assign speed = speeds[speed_index] -%}

          {%- comment -%} Handle both file_reference and url/text metafield types {%- endcomment -%}
          {%- if tp_meta.value != blank -%}
            {%- assign tp_img_url = tp_meta.value | image_url: width: 800 -%}
          {%- else -%}
            {%- assign tp_img_url = tp_meta | image_url: width: 800 -%}
          {%- endif -%}

          <a
            class="tp-float-carousel__item"
            href="{{ product.url }}"
            data-parallax-speed="{{ speed }}"
            style="min-width: calc({{ item_width_pct }}% - 16px);"
          >
            <div class="tp-float-carousel__image-wrap">
              <img
                src="{{ tp_img_url }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
                width="800"
                height="800"
              >
            </div>

            {%- if section.settings.show_title -%}
              <p class="tp-float-carousel__product-title">{{ product.title | escape }}</p>
            {%- endif -%}

            {%- if section.settings.show_price -%}
              <p class="tp-float-carousel__product-price">{{ product.price | money }}</p>
            {%- endif -%}
          </a>

          {%- assign item_index = item_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if item_index == 0 -%}
        <p style="padding: 40px; text-align: center; opacity: 0.5; width: 100%;">No products found with a transparent_image metafield in this collection.</p>
      {%- endif -%}
    </div>

    {%- if item_index > 0 -%}
    <button
      type="button"
      class="tp-float-carousel__arrow tp-float-carousel__arrow--prev"
      aria-label="Previous"
      aria-controls="tp-track-{{ section.id }}"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button
      type="button"
      class="tp-float-carousel__arrow tp-float-carousel__arrow--next"
      aria-label="Next"
      aria-controls="tp-track-{{ section.id }}"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    {%- endif -%}
  </div>
</div>

<style>
  .tp-float-carousel {
    position: relative;
    overflow: hidden;
  }

  .tp-float-carousel__title {
    text-align: center;
    margin: 0 0 24px;
    font-size: 28px;
    line-height: 1.2;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .tp-float-carousel__title {
      font-size: 36px;
      margin-bottom: 32px;
    }
  }

  .tp-float-carousel__wrapper {
    position: relative;
    padding: 0 40px;
  }

  @media screen and (max-width: 749px) {
    .tp-float-carousel__wrapper {
      padding: 0 12px;
    }
  }

  .tp-float-carousel__track {
    display: flex;
    flex-wrap: nowrap;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 20px 0;
  }

  .tp-float-carousel__track::-webkit-scrollbar {
    display: none;
  }

  .tp-float-carousel__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    text-align: center;
    will-change: transform;
    transition: transform 0.1s linear;
  }

  @media screen and (max-width: 749px) {
    .tp-float-carousel__item {
      min-width: 60% !important;
    }
  }

  .tp-float-carousel__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tp-float-carousel__image-wrap img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .tp-float-carousel__product-title {
    margin: 8px 0 4px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .tp-float-carousel__product-price {
    margin: 0;
    font-size: 14px;
    opacity: 0.8;
  }

  /* Arrow buttons */
  .tp-float-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.2s ease;
    color: #000;
  }

  .tp-float-carousel__arrow:hover {
    opacity: 0.7;
  }

  .tp-float-carousel__arrow--prev {
    left: 0;
  }

  .tp-float-carousel__arrow--next {
    right: 0;
  }

  @media screen and (max-width: 749px) {
    .tp-float-carousel__arrow {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var intensity = {{ parallax_intensity }};
    var section = document.querySelector('[data-parallax-section="' + sectionId + '"]');
    if (!section) return;

    var track = section.querySelector('.tp-float-carousel__track');
    var items = section.querySelectorAll('.tp-float-carousel__item');
    var prevBtn = section.querySelector('.tp-float-carousel__arrow--prev');
    var nextBtn = section.querySelector('.tp-float-carousel__arrow--next');
    var active = false;
    var ticking = false;

    /* ---- Parallax ---- */
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        active = entry.isIntersecting;
      });
    }, { threshold: 0 });

    observer.observe(section);

    function applyParallax() {
      if (!active) return;
      var rect = section.getBoundingClientRect();
      var scrollOffset = window.innerHeight - rect.top;

      items.forEach(function (item) {
        var speed = parseFloat(item.getAttribute('data-parallax-speed')) || 0.03;
        var y = scrollOffset * speed * (intensity / 0.05);
        item.style.transform = 'translateY(' + y.toFixed(2) + 'px)';
      });
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () {
          applyParallax();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    /* ---- Arrow navigation ---- */
    if (prevBtn && nextBtn && track) {
      var scrollAmount = function () {
        var firstItem = track.querySelector('.tp-float-carousel__item');
        return firstItem ? firstItem.offsetWidth + 16 : 300;
      };

      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Transparent Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to use the All collection"
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "label": "Maximum products"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Items per view (desktop)"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "default": true,
      "label": "Show product title"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show product price"
    },
    {
      "type": "header",
      "content": "Parallax"
    },
    {
      "type": "range",
      "id": "parallax_intensity",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "x",
      "label": "Parallax intensity"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Transparent Carousel"
    }
  ]
}
{% endschema %}
