{%- liquid
  if section.settings.collection != blank
    assign source_collection = section.settings.collection
  else
    assign source_collection = collections['all']
  endif

  assign max_items = section.settings.max_items
  assign parallax_intensity = section.settings.parallax_intensity | times: 0.01
  assign items_per_row = section.settings.items_per_row
  assign mobile_items_per_row = section.settings.mobile_items_per_row
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="tp-float-carousel section-{{ section.id }}-padding"
  data-parallax-section="{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }};"
>
  {%- if section.settings.title != blank -%}
    <h2 class="tp-float-carousel__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="tp-float-carousel__grid" id="tp-grid-{{ section.id }}">
    {%- assign item_index = 0 -%}
    {%- assign speeds = '0.03,0.06,0.04,0.05,0.02' | split: ',' -%}
    {%- assign scan_limit = source_collection.products_count | at_most: 500 -%}
    {%- assign batch_count = scan_limit | divided_by: 50 -%}

    {%- for batch in (0..batch_count) -%}
      {%- if item_index >= max_items -%}{%- break -%}{%- endif -%}
      {%- assign batch_offset = batch | times: 50 -%}

      {%- for product in source_collection.products limit: 50 offset: batch_offset -%}
        {%- if item_index >= max_items -%}{%- break -%}{%- endif -%}
        {%- assign tp_meta = product.metafields.custom.transparent_image -%}
        {%- if tp_meta != blank -%}
          {%- assign speed_index = item_index | modulo: speeds.size -%}
          {%- assign speed = speeds[speed_index] -%}

          {%- if tp_meta.value != blank -%}
            {%- assign tp_img_url = tp_meta.value | image_url: width: 400 -%}
          {%- else -%}
            {%- assign tp_img_url = tp_meta | image_url: width: 400 -%}
          {%- endif -%}

          <a class="tp-float-carousel__item" href="{{ product.url }}" data-parallax-speed="{{ speed }}">
            <img
              src="{{ tp_img_url }}"
              alt="{{ product.title | escape }}"
              loading="lazy"
            >
          </a>

          {%- assign item_index = item_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}

    {%- if item_index == 0 -%}
      <p style="padding: 40px; text-align: center; opacity: 0.5; width: 100%; grid-column: 1 / -1;">No products found with a transparent_image metafield in this collection.</p>
    {%- endif -%}
  </div>
</div>

<style>
  .tp-float-carousel {
    position: relative;
    overflow: hidden;
  }

  .tp-float-carousel__title {
    text-align: center;
    margin: 0 0 16px;
    font-size: 28px;
    line-height: 1.2;
    color: inherit;
  }

  @media screen and (min-width: 750px) {
    .tp-float-carousel__title {
      font-size: 36px;
      margin-bottom: 24px;
    }
  }

  .tp-float-carousel__grid {
    display: grid;
    grid-template-columns: repeat({{ mobile_items_per_row }}, 1fr);
    gap: 8px;
    padding: 0 12px;
  }

  @media screen and (min-width: 750px) {
    .tp-float-carousel__grid {
      grid-template-columns: repeat({{ items_per_row }}, 1fr);
      gap: 12px;
      padding: 0 40px;
    }
  }

  .tp-float-carousel__item {
    display: block;
    will-change: transform;
    transition: transform 0.1s linear;
  }

  .tp-float-carousel__item img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var intensity = {{ parallax_intensity }};
    var el = document.querySelector('[data-parallax-section="' + sectionId + '"]');
    if (!el) return;

    var items = el.querySelectorAll('.tp-float-carousel__item');
    var active = false;
    var ticking = false;

    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        active = entry.isIntersecting;
      });
    }, { threshold: 0 });

    observer.observe(el);

    function applyParallax() {
      if (!active) return;
      var rect = el.getBoundingClientRect();
      var scrollOffset = window.innerHeight - rect.top;

      items.forEach(function (item) {
        var speed = parseFloat(item.getAttribute('data-parallax-speed')) || 0.03;
        var y = scrollOffset * speed * (intensity / 0.05);
        item.style.transform = 'translateY(' + y.toFixed(2) + 'px)';
      });
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        requestAnimationFrame(function () {
          applyParallax();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Transparent Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Pick a collection containing products with the transparent_image metafield. 'All' only scans the first page of products."
    },
    {
      "type": "range",
      "id": "max_items",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 20,
      "label": "Maximum products"
    },
    {
      "type": "range",
      "id": "items_per_row",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6,
      "label": "Items per row (desktop)"
    },
    {
      "type": "range",
      "id": "mobile_items_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Items per row (mobile)"
    },
    {
      "type": "header",
      "content": "Parallax"
    },
    {
      "type": "range",
      "id": "parallax_intensity",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "x",
      "label": "Parallax intensity"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Transparent Carousel"
    }
  ]
}
{% endschema %}
